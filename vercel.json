{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/api/predict-crop",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/recommend-crop",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/calculate-health-score",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/predict-disease",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/chatbot-context",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/government-schemes",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/predict-soil",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/predict-yield",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/api/predict-fertilizer",
      "destination": "/backend/api/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
